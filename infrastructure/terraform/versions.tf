# -----------------------------------------------------------------------------
# VayuSetu - Terraform and provider version constraints
#
# State is stored in a Google Cloud Storage bucket. The bucket name and prefix
# are supplied at init time so that the same configuration can serve multiple
# environments:
#
#   terraform init -backend-config=backend.hcl
#
# See backend.hcl.example for the expected keys.
# -----------------------------------------------------------------------------

terraform {
  required_version = ">= 1.6.0"

  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 6.0"
    }
    google-beta = {
      source  = "hashicorp/google-beta"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  backend "gcs" {}
}

provider "google" {
  project               = var.project_id
  region                = var.region
  user_project_override = true
  billing_project       = var.project_id
}

provider "google-beta" {
  project               = var.project_id
  region                = var.region
  user_project_override = true
  billing_project       = var.project_id
}
