# =============================================================================
# VayuSetu environment configuration
#
# Copy this file to .env for docker-compose, or export the relevant subset when
# running an individual service. Values shown are safe local defaults; replace
# them with real credentials only in deployed environments (Secret Manager) and
# never commit populated .env files.
# =============================================================================

# -----------------------------------------------------------------------------
# Google Cloud project and region
# -----------------------------------------------------------------------------
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
# Project id used by the local emulator stack (docker-compose only)
LOCAL_PROJECT_ID=vayusetu-local
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Storage buckets and BigQuery (names produced by Terraform outputs)
# -----------------------------------------------------------------------------
CITIZEN_IMAGES_BUCKET=your-gcp-project-id-vayusetu-citizen-images
ALERT_AUDIO_BUCKET=your-gcp-project-id-vayusetu-alert-audio
ML_ARTIFACTS_BUCKET=your-gcp-project-id-vayusetu-ml-artifacts
BIGQUERY_DATASET=vayusetu
# Set to false to disable BigQuery writes (always false in docker-compose)
BIGQUERY_ENABLED=true
# load (free, batch load jobs) or stream (streaming inserts, billed)
BIGQUERY_WRITE_MODE=load

# -----------------------------------------------------------------------------
# Twilio WhatsApp Business (sandbox works for development)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=+14155238886
# Validate X-Twilio-Signature on webhooks (true in production)
TWILIO_VALIDATE_SIGNATURE=true
# Override the Twilio API base URL (docker-compose points this at mock-twilio)
TWILIO_API_BASE_URL=https://api.twilio.com
# Public HTTPS URL of the API gateway, used to reconstruct signed webhook URLs
PUBLIC_BASE_URL=https://vayusetu-api-gateway-xxxxxxxx-uc.a.run.app

# -----------------------------------------------------------------------------
# API gateway (services/api-gateway)
# -----------------------------------------------------------------------------
PORT=8080
NODE_ENV=development
GCS_BUCKET=your-gcp-project-id-vayusetu-citizen-images
GCS_REPORT_PREFIX=reports
# HMAC secret used to pseudonymise phone numbers (Secret Manager: vayusetu-phone-hash-secret)
PHONE_HASH_SECRET=change-me-to-a-long-random-string
# Comma separated Google Workspace domains allowed to use the dashboard and read API
ADMIN_DOMAIN=example.gov.in
HOTSPOT_GEOHASH_PRECISION=5
REPORT_GEOHASH_PRECISION=7
LOCATION_MAX_AGE_HOURS=24
PENDING_LOCATION_WINDOW_MINUTES=30
MAX_IMAGE_BYTES=10485760
RATE_LIMIT_PER_HOUR=30
REQUEST_TIMEOUT_MS=12000

# -----------------------------------------------------------------------------
# Gemini vision function (functions/process_citizen_image)
# -----------------------------------------------------------------------------
# Google AI Studio key (free tier). Secret Manager: vayusetu-google-ai-studio-api-key
GOOGLE_AI_STUDIO_API_KEY=your-google-ai-studio-key
# Ordered fallback chain; the first model that is available is used
GEMINI_MODEL_CANDIDATES=gemini-1.5-flash,gemini-flash-latest,gemini-3.5-flash-lite,gemini-2.5-flash
# Optional endpoint override (docker-compose points this at mock-google-ai)
GEMINI_API_ENDPOINT=
GEMINI_MAX_ATTEMPTS_PER_MODEL=4
GEMINI_BASE_DELAY_SECONDS=2
GEMINI_MAX_DELAY_SECONDS=45
GEMINI_REQUEST_TIMEOUT_SECONDS=60
# Images are downscaled to this longest edge before being sent to Gemini
MAX_IMAGE_EDGE_PX=1024
REPORT_OBJECT_PREFIX=reports/
# Send the citizen a WhatsApp summary once analysis completes
SEND_USER_FEEDBACK=true

# -----------------------------------------------------------------------------
# Earth Engine function (functions/fetch_gee_metrics)
# -----------------------------------------------------------------------------
# Cloud project registered for Earth Engine (non-commercial tier)
GEE_PROJECT=your-gcp-project-id
GEE_USE_HIGH_VOLUME_ENDPOINT=true
GEE_BUFFER_METERS=5000
GEE_LOOKBACK_DAYS=3
# Deterministic mock metrics instead of calling Earth Engine (local development)
GEE_MOCK=false
GEE_ALLOW_MOCK_FALLBACK=false

# -----------------------------------------------------------------------------
# Alerting function (functions/send_authority_alerts)
# -----------------------------------------------------------------------------
ALERT_AQI_THRESHOLD=300
ALERT_COOLDOWN_MINUTES=180
ALERT_MAX_RECIPIENTS=10
# Use in-process stand-ins for Cloud Translation and Text-to-Speech
ALERTS_MOCK_GOOGLE_APIS=false
# Log alerts without placing calls or sending messages
ALERTS_DRY_RUN=false
TTS_VOICE_TIER=standard
TTS_SPEAKING_RATE=0.92
DASHBOARD_URL=https://your-gcp-project-id.web.app

# -----------------------------------------------------------------------------
# Batch prediction function (functions/batch_predict)
# -----------------------------------------------------------------------------
PREDICTION_SERVICE_URL=https://vayusetu-prediction-service-xxxxxxxx-uc.a.run.app
# Send Google-signed OIDC tokens to the prediction service (false for plain http)
PREDICTION_SERVICE_AUTH=true
PREDICTION_TIMEOUT_SECONDS=90
# bigquery (production) or firestore (emulator and small deployments)
DATA_SOURCE=bigquery
FALLBACK_TO_FIRESTORE=true
LOOKBACK_HOURS=6
MIN_REPORTS_PER_CELL=1
MAX_CELLS_PER_RUN=400
# open-meteo (free, no key) or synthetic
WEATHER_PROVIDER=open-meteo
BATCH_LOOKBACK_HOURS=6
BATCH_INTERVAL_SECONDS=600

# -----------------------------------------------------------------------------
# Prediction service (services/prediction-service)
# -----------------------------------------------------------------------------
MODEL_PATH=/app/model/model.joblib
MODEL_GCS_URI=gs://your-gcp-project-id-vayusetu-ml-artifacts/models/model.joblib
PREFER_GCS_MODEL=true
FORECAST_HORIZON_HOURS=12
MAX_BATCH_SIZE=500

# -----------------------------------------------------------------------------
# Dashboard (frontend, build-time public values)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-gcp-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-gcp-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-gcp-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_ADMIN_DOMAIN=example.gov.in
NEXT_PUBLIC_API_GATEWAY_URL=http://localhost:8081
NEXT_PUBLIC_DEFAULT_MAP_CENTER=28.6139,77.2090
NEXT_PUBLIC_USE_EMULATORS=true
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080
NEXT_PUBLIC_AUTH_EMULATOR_URL=http://localhost:9099
DEFAULT_MAP_CENTER=28.6139,77.2090

# -----------------------------------------------------------------------------
# Local mocks (docker-compose only)
# -----------------------------------------------------------------------------
MOCK_AVAILABLE_MODELS=gemini-2.5-flash,gemini-flash-latest
MOCK_RATE_LIMIT_PROBABILITY=0.1
MOCK_LATENCY_MS=400
EMULATOR_EXPORT_ON_EXIT=true
GATEWAY_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Emulator hosts (set automatically inside docker-compose; export manually when
# running services on the host against the emulators)
# -----------------------------------------------------------------------------
# FIRESTORE_EMULATOR_HOST=localhost:8080
# STORAGE_EMULATOR_HOST=http://localhost:4443
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
